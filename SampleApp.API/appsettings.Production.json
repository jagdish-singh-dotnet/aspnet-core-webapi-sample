{
  "App": {
    "Name": "AspnetCoreWebApiSample",
    "Environment": "Production",
    "Version": "1.0.0"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "testdomain.com",

  "JwtSettings": {
    "Key": "THIS_IS_A_SUPER_SECRET_KEY_123456",
    "Issuer": "MyApp",
    "Audience": "MyAppUsers",
    "ExpiryMinutes": 60
  },

  "Swagger": {
    "Enabled": false
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=PROD_DB_SERVER;Database=AspnetCoreWebApiSample_Prod;User Id=PROD_USER;Password=PROD_PASSWORD;"
  },

  "HealthChecks": {
    "Enabled": true
  },

  "Security": {
    "RequireHttps": true
  }
}
